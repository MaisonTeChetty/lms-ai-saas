# Copy to .env.local and fill in the blank values. Never commit .env.local.
# Clerk dashboard: application API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity project dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-27
NEXT_PUBLIC_SANITY_ORG_ID=
# Read token: Viewer role; write token: Editor role (server-side only).
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# AI tutor
OPENAI_API_KEY=
ENABLE_CHAT_LOGS=false

# Mux Video API credentials and a base64-encoded signing private key
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY=

# Comma-separated Clerk user IDs; only the server variable grants admin access.
ADMIN_CLERK_USER_IDS=
# Optional copy of the IDs to show the Admin link; this does not grant access.
NEXT_PUBLIC_ADMIN_CLERK_USER_IDS=
ALLOWED_ORIGINS=http://localhost:3000
